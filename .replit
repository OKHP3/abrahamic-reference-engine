modules = ["python-3.14", "web", "nodejs-24"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["notion:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "pango", "cairo", "fontconfig", "freetype", "harfbuzz", "alsa-lib", "libdrm", "mesa", "libxkbcommon", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "libgbm", "libGL", "libGLU", "xorg.libXi", "xorg.libXrender"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mercury-dates"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "mercury-dates"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node .agents/skills/okhp3-celestial-data/scripts/validate-mercury-dates.cjs"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "preview"]

[postMerge]
path = ".local/post-merge.sh"
timeoutMs = 60000

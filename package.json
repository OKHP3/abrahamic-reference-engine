{
  "name": "abrahamic-reference-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test:unit": "node --import tsx --test tests/api-contracts.test.ts",
    "test:pages": "node scripts/check-pages-artifact.js",
    "test:api": "node scripts/test-api-live.js",
    "test:skill-sync": "node scripts/check-skill-sync.js",
    "test:mercury-dates": "node .agents/skills/okhp3-celestial-data/scripts/validate-mercury-dates.cjs",
    "test:e2e": "playwright test",
    "test:e2e:pages": "cp dist/index.html dist/404.html && PLAYWRIGHT_PAGES=true playwright test --project=pages --grep \"GitHub Pages (shared lookup route|public routes)\"",
    "test:e2e:pages:hosted": "PLAYWRIGHT_PAGES=true PLAYWRIGHT_HOSTED=true playwright test --project=pages --grep \"GitHub Pages (shared lookup route|public routes)\""
  },
  "dependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
